{
  "$schema": "https://railway.app/railway.schema.json",
  "services": {
    "bot-runner": {
      "source": "apps/bot-runner",
      "deploy": {
        "startCommand": "python run-all-bots.py",
        "restartPolicy": {
          "type": "on-failure",
          "maxRestarts": 5
        }
      }
    }
  }
}
