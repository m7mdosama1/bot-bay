# =============================================================================
# Bot Bay — Environment Variables (.env.example)
# =============================================================================
# Two deployment targets:
#   - Railway: apps/bot-runner/.env (all 9 Discord bots in one service)
#   - Vercel:  apps/web/.env      (Next.js web dashboard)
# =============================================================================

# ---- Railway: Bot Runner (apps/bot-runner/.env) ----
# PostgreSQL database (use Railway's PG plugin URL)
DATABASE_URL=postgresql+asyncpg://user:password@host:port/botbay

# Discord bot tokens (one per bot application)
BOT_VERIFICATION_TOKEN=
BOT_GIVEAWAY_TOKEN=
BOT_ROULETTE_TOKEN=
BOT_ADMIN_TOKEN=
BOT_WELCOME_TOKEN=
BOT_TICKET_TOKEN=
BOT_BEACON_TOKEN=
BOT_PULSE_TOKEN=
BOT_ASCEND_TOKEN=
PUBLIC_WEB_URL=https://your-web-app.vercel.app

# Fallback defaults only; server owners can override these from the dashboard
BEACON_POLL_SECONDS=120
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
KICK_CLIENT_ID=your_kick_client_id
KICK_CLIENT_SECRET=your_kick_client_secret
KICK_API_BASE=https://api.kick.com/public/v1
KICK_TOKEN_URL=https://id.kick.com/oauth/token
XP_COOLDOWN_SECONDS=60
XP_PER_MESSAGE_MIN=15
XP_PER_MESSAGE_MAX=25

# Optional: verification bot APIs
IPQUALITYSCORE_API_KEY=
PROXYCHECK_API_KEY=

# Optional: welcome bot config
VERIFIED_ROLE_ID=


# ---- Vercel: Web Dashboard (apps/web/.env) ----
NEXTAUTH_URL=https://your-app.vercel.app
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32

# Discord OAuth app (for web login)
DISCORD_CLIENT_ID=YOUR_WEB_APP_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_WEB_APP_SECRET

# Admin panel
ADMIN_SECRET_PATH=__admin_panel_b7f3a9c2__
ADMIN_ALLOWLIST=your_discord_id_here

# Bot client IDs (Discord snowflakes — for OAuth2 "Add to Server" links)
BOT_VERIFICATION_CLIENT_ID=123456789012345678
BOT_GIVEAWAY_CLIENT_ID=123456789012345680
BOT_ROULETTE_CLIENT_ID=123456789012345682
BOT_ADMIN_CLIENT_ID=123456789012345684
BOT_WELCOME_CLIENT_ID=123456789012345686
BOT_TICKET_CLIENT_ID=123456789012345688
BOT_BEACON_CLIENT_ID=your_beacon_client_id
BOT_PULSE_CLIENT_ID=your_pulse_client_id
BOT_ASCEND_CLIENT_ID=your_ascend_client_id

# TOTP for admin 2FA
TOTP_SECRET=generate_with_otp_lib
