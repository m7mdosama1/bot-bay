# =============================================================================
# Bot Bay — Environment Variables (.env.example)
# =============================================================================
# Copy this to .env and fill in real values.
# For Railway: set these in the Railway dashboard per-service.
# =============================================================================

# ---- Shared ----
# PostgreSQL connection string (use Railway's PG plugin URL)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/botbay

# ---- Web Dashboard (apps/web/.env) ----
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
DISCORD_CLIENT_ID=YOUR_WEB_APP_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_WEB_APP_SECRET

ADMIN_SECRET_PATH=__admin_panel_b7f3a9c2__
ADMIN_ALLOWLIST=your_discord_id_here

BOT_VERIFICATION_CLIENT_ID=123456789012345678
BOT_GIVEAWAY_CLIENT_ID=123456789012345680
BOT_ROULETTE_CLIENT_ID=123456789012345682
BOT_ADMIN_CLIENT_ID=123456789012345684
BOT_WELCOME_CLIENT_ID=123456789012345686
BOT_TICKET_CLIENT_ID=123456789012345688

TOTP_SECRET=generate_with_otp_lib

# Bot tokens (for reference)
BOT_VERIFICATION_TOKEN=
BOT_GIVEAWAY_TOKEN=
BOT_ROULETTE_TOKEN=
BOT_ADMIN_TOKEN=
BOT_WELCOME_TOKEN=
BOT_TICKET_TOKEN=

# Verification bot APIs
IPQUALITYSCORE_API_KEY=
PROXYCHECK_API_KEY=

# ---- Bot Tokens (one per Discord bot application) ----
# Each bot directory .env needs DISCORD_TOKEN and DATABASE_URL

# bot-verification
#   DISCORD_TOKEN=verification_bot_token
#   DATABASE_URL=postgresql+asyncpg://...
#   IPQUALITYSCORE_API_KEY=...
#   PROXYCHECK_API_KEY=...

# bot-giveaway
#   DISCORD_TOKEN=giveaway_bot_token
#   DATABASE_URL=postgresql+asyncpg://...

# bot-roulette
#   DISCORD_TOKEN=roulette_bot_token
#   DATABASE_URL=postgresql+asyncpg://...

# bot-admin
#   DISCORD_TOKEN=admin_bot_token
#   DATABASE_URL=postgresql+asyncpg://...

# bot-ticket
#   DISCORD_TOKEN=ticket_bot_token
#   DATABASE_URL=postgresql+asyncpg://...

# bot-welcome
#   DISCORD_TOKEN=welcome_bot_token
#   DATABASE_URL=postgresql+asyncpg://...
#   VERIFIED_ROLE_ID=your_verified_role_id
