# Bot Bay — Unified Bot Runner (.env)
# Deploy this single service to Railway to run all 9 bots concurrently.

# PostgreSQL database (use Railway's PG plugin URL)
DATABASE_URL=postgresql+asyncpg://user:password@host:port/botbay

# Discord bot tokens (one per bot)
BOT_VERIFICATION_TOKEN=
BOT_GIVEAWAY_TOKEN=
BOT_ROULETTE_TOKEN=
BOT_ADMIN_TOKEN=
BOT_WELCOME_TOKEN=
BOT_TICKET_TOKEN=
BOT_BEACON_TOKEN=
BOT_PULSE_TOKEN=
BOT_ASCEND_TOKEN=

# Public web origin used by Beacon/Roulette browser links
PUBLIC_WEB_URL=https://bot-bay-kappa.vercel.app

# Fallback defaults; per-server settings are stored in the database
BEACON_POLL_SECONDS=120
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
KICK_CLIENT_ID=your_kick_client_id
KICK_CLIENT_SECRET=your_kick_client_secret
KICK_API_BASE=https://api.kick.com/public/v1
KICK_TOKEN_URL=https://id.kick.com/oauth/token
XP_COOLDOWN_SECONDS=60
XP_PER_MESSAGE_MIN=15
XP_PER_MESSAGE_MAX=25

# Verification bot APIs (optional)
IPQUALITYSCORE_API_KEY=
PROXYCHECK_API_KEY=

# Welcome bot role (optional)
VERIFIED_ROLE_ID=
